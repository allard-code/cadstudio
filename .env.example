# Copy to .env and fill in.
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
CADSTUDIO_TOKEN=replace-me-with-a-long-random-token
# The address you reach the server on, e.g. http://192.168.1.50:8765 or https://cad.example.com
CADSTUDIO_PUBLIC_URL=http://192.168.1.50:8765
