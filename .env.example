# Kopieer naar .env en vul in.
# Token maken: python -c "import secrets; print(secrets.token_urlsafe(32))"
CADSTUDIO_TOKEN=vervang-mij-door-een-lang-willekeurig-token
# Adres waarop je de server bereikt, bv. http://192.168.1.50:8765 of https://cad.jouwdomein.nl
CADSTUDIO_PUBLIC_URL=http://192.168.1.50:8765
