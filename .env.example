# Copy to .env and fill in.
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
CADSTUDIO_TOKEN=replace-me-with-a-long-random-token
# The address you reach the server on, e.g. http://192.168.1.50:8765 or https://cad.example.com
CADSTUDIO_PUBLIC_URL=http://192.168.1.50:8765
# Printer for slice_plate (an OrcaSlicer system profile name; vendor = the folder it lives in)
# CADSTUDIO_PRINTER=Anycubic Kobra S1 0.4 nozzle
# CADSTUDIO_PRINTER_VENDOR=Anycubic
# Optional: Home Assistant for send_to_printer (uploads G-code + fires the event cadstudio_print_request)
# The token must be a long-lived access token of an admin user (Profile -> Security).
# CADSTUDIO_HA_URL=http://192.168.1.10:8123
# CADSTUDIO_HA_TOKEN=
